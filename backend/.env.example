# Database
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=taphoa

# Server
PORT=8082
STATIC_DIR=../frontend/build

# Frontend URL (CORS) — chỉ cần khi dev, production dùng STATIC_DIR
FRONTEND_URL=http://localhost:3001

# Email alerts (Gmail SMTP)
# Bước 1: Bật 2FA trên Google Account
# Bước 2: Tạo App Password tại https://myaccount.google.com/apppasswords
# Bước 3: Điền thông tin bên dưới
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_RECIPIENTS=me@gmail.com,mom@gmail.com
