# Database
# Local: port 5433 (Docker), prod: port 5432 (cài trực tiếp)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=taphoa

# Server
PORT=8082
GIN_MODE=release
STATIC_DIR=../frontend/build

# Frontend URL (CORS) — chỉ cần khi dev, production serve static nên không cần
# FRONTEND_URL=http://localhost:3001

# Email alerts (Gmail SMTP)
# Bước 1: Bật 2FA trên Google Account
# Bước 2: Tạo App Password tại https://myaccount.google.com/apppasswords
# Bước 3: Điền thông tin bên dưới
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_RECIPIENTS=me@gmail.com,mom@gmail.com
